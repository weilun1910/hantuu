# hantuu's terminal look, used for every chat and shell unless Settings > Terminal is set
# to use your own Ghostty config instead. Same format as a Ghostty config file.

# Type. JetBrains Mono is built into Ghostty, so this works without installing it.
font-family = "JetBrains Mono"
font-size = 13
font-thicken = true
font-feature = -calt
adjust-cell-height = 25%

# Space around the text, filled with the background colour.
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
window-padding-color = extend
window-colorspace = display-p3
background-opacity = 1

# A solid block cursor that doesn't blink. no-cursor stops shell integration from
# switching it to a bar; title lets agents name their chat.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,sudo,title
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# Colours follow hantuu's appearance (Settings > Appearance: light, dark, or match macOS).
# Both themes ship inside the app, in Contents/Resources/ghostty/themes.
theme = light:hantuu-light,dark:hantuu-dark
